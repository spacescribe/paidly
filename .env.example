# --- PayPal (optional — omit entirely to stay in mock mode) ---
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com

# --- LLM provider selection (optional — defaults shown) ---
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-5

# --- Anthropic (required when LLM_PROVIDER=anthropic) ---
ANTHROPIC_API_KEY=

# --- OpenRouter (required only when LLM_PROVIDER=openrouter) ---
# Use OpenRouter's own catalog slug for LLM_MODEL, e.g. anthropic/claude-sonnet-5
OPENROUTER_API_KEY=
